# Google Business Profile / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_BACKEND_URL=https://gbpilot.top

# Creem.io Payments Integration
# Set to 'true' for isolated test mode (https://test-api.creem.io/v1), 'false' for production
CREEM_TEST_MODE=true

# Creem API Key (Find in Creem Dashboard -> Developers -> API Keys while in Test Mode)
CREEM_API_KEY=creem_test_your_api_key_here

# Creem Webhook Secret (Find in Creem Dashboard -> Developers -> Webhooks)
CREEM_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Creem Product IDs (Created in Creem Dashboard -> Products)
