# --- Supabase Database ---
# The connection string to your Supabase PostgreSQL database
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Make sure to replace [YOUR-PASSWORD] with the actual password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# --- Google Gemini API (For Proactive Recommendations) ---
# Get your free key at: aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google OAuth 2.0 Credentials (For GBP Profile Integration) ---
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Celery & Redis (For Background Jobs) ---
# When deployed on Railway, Railway can provide a Redis instance
# Local fallback:
REDIS_URL=redis://localhost:6379/0

# --- FastAPI Server ---
# Used for Vercel CORS configuration (optional, if you want to restrict CORS)
FRONTEND_URL=https://your-vercel-project.vercel.app
